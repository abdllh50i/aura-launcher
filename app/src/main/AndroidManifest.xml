<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- normal -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- the voice assistant "عمري": its wake word, and the speech recogniser it asks (runtime permission) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Aura's volume display over other apps (allowed through appops by the ROM / Aura's root shell) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- privileged: granted only when installed as a system app (see privapp-permissions-aura.xml) -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />

    <!-- Android 11+ only shows an app the services it declares here: the speech recogniser and text to speech -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AuraApp"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aura"
        android:networkSecurityConfig="@xml/network_security"
        android:usesCleartextTraffic="${cleartext}">

        <!-- The launcher (Home). Also listed in the app list (LAUNCHER) so it can be opened before it is activated. -->
        <activity
            android:name=".home.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Aura.Home"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home screen of the first moments after a power-on, while the user's storage is still closed and only
             direct-boot aware screens exist: without it the stock launcher is the only home screen the firmware
             finds then, and it stays (see home/BootHome.kt). A process of its own, in which AuraApp does nothing.
             The low priority: once the user is unlocked HomeActivity comes first for the home intent.
             Off here and switched on by the app on the car unit (BootHome.ensure): on a stock Android a second home
             screen in the package makes the system drop the home app that was chosen. -->
        <activity
            android:name=".home.BootHome"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:directBootAware="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:process=":boot"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:taskAffinity="com.abdllh.aura.boot"
            android:theme="@style/Theme.Aura.Boot">
            <intent-filter android:priority="-900">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Starts AMRI's process when the unit has started, whatever is in front: HomeGuard then sees a stock screen
             that took the home screen's place (the second line of defence behind BootHome). -->
        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter android:priority="900">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- The guard: a process apart, which sees the crashes that end the main process before it can say anything
             (see guard/GuardService.kt). AuraApp does nothing there. Also started by the main process at each start. -->
        <receiver
            android:name=".guard.GuardReceiver"
            android:exported="true"
            android:process=":guard">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".guard.GuardService"
            android:exported="false"
            android:process=":guard" />

        <!-- AMRI Rescue: a second icon, for the stock launcher's app list after a bail-out (AMRI's own list leaves its own
             package out). In the guard's process, with plain Android views. -->
        <activity
            android:name=".guard.RescueActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/rescue_name"
            android:process=":guard"
            android:screenOrientation="landscape"
            android:taskAffinity="com.abdllh.aura.rescue"
            android:theme="@style/Theme.Aura.Boot">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/set_title"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aura"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="com.abdllh.aura.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.abdllh.aura.action.UPDATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Settings › About › Screen check (diag/ScreenCheck.kt): the page in the main process, and the tests that
             load GL or native code in a process of their own, in which AuraApp does nothing: a native crash there
             cannot touch the home screen. Nothing starts them but the page's button. -->
        <activity
            android:name=".settings.ScreenCheckActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false"
            android:label="@string/diag_title"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aura"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".diag.ProbeActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="false"
            android:launchMode="singleTop"
            android:process=":diag"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aura.Boot" />

        <activity
            android:name=".nav.MapsActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/dock_nav"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aura.Heavy"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="com.abdllh.aura.action.MAPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".nav.NavService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Valhalla's native code runs in a process of its own (nav/route/RouteProcess.kt). The route probe of the scout
             release: does it run on the unit at all? -->
        <service
            android:name=".nav.route.RouteProbeService"
            android:exported="false"
            android:process=":route" />

        <!-- Aura Music. Exported with MAIN: the firmware's source manager starts it for app id 2 (Music/Mode keys,
             USB insertion) once replace_source_list.xml points there. -->
        <activity
            android:name=".music.MusicActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/music_title"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Aura.Heavy"
            android:windowSoftInputMode="adjustNothing|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.abdllh.aura.action.MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" android:mimeType="audio/*" />
                <data android:scheme="content" android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".music.MusicService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- listens for the wake word "عمري" (the microphone from the background needs a foreground service) -->
        <service
            android:name=".voice.AmriService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.abdllh.aura.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".media.AuraNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
