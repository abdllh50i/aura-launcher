<?xml version="1.0" encoding="utf-8"?>
<!-- the screen coming back when the one above closes: it steps forward again -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:duration="240"
        android:fromXScale="0.97"
        android:fromYScale="0.97"
        android:interpolator="@interpolator/aura_emphasized"
        android:pivotX="50%"
        android:pivotY="50%"
        android:toXScale="1"
        android:toYScale="1" />
    <alpha
        android:duration="240"
        android:fromAlpha="0.6"
        android:interpolator="@interpolator/aura_emphasized"
        android:toAlpha="1" />
</set>
