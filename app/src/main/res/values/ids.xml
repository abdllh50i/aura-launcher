<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- a view's press spring (ui/Motion.kt pressScale) -->
    <item name="aura_press_spring" type="id" />
    <!-- set while pressScale holds the view in a hardware layer it put there itself (taken off when it is back at rest) -->
    <item name="aura_press_layer" type="id" />
    <!-- set while ui/Motion.kt exit() runs: an enter() then turns back from where the view is -->
    <item name="aura_exiting" type="id" />
    <!-- a resizing view's own elevation, kept while a LayoutMove plays without it -->
    <item name="aura_move_elevation" type="id" />
    <!-- the message an activity shows (ui/Snack.kt), on its content view -->
    <item name="aura_snack" type="id" />
    <!-- what a view does at a theme change (ui/Look.kt) -->
    <item name="aura_look" type="id" />
    <!-- a hidden panel that has not taken the new theme yet (ui/Look.kt) -->
    <item name="aura_look_stale" type="id" />
    <!-- a view's PressGesture when pressScale made it (ui/PressGesture.kt) -->
    <item name="aura_press_gesture" type="id" />
</resources>
