<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aura" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@style/Aura.ScreenChange</item>
        <!-- No starting window: it can only be drawn in these XML colours, the dark theme's, so on the light theme
             (all day under "auto") every screen opened on near-black for the whole of its onCreate. The opening
             animation starts on the screen's real first frame instead; the press on what opened it answered the tap. -->
        <item name="android:windowDisablePreview">true</item>
    </style>

    <!-- Opening and closing AMRI's screens (they play while the system's transition animations are on: see
         system/Animations.kt; this firmware ships with them off). -->
    <style name="Aura.ScreenChange" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/aura_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/aura_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/aura_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/aura_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/aura_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/aura_open_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/aura_close_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/aura_close_exit</item>
    </style>

    <!-- The home screen keeps its starting window: it is only seen at a cold start, where something must show at once. -->
    <style name="Theme.Aura.Home" parent="Theme.Aura">
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <!-- Maps and Music keep their starting window: their first frame comes after heavy work (MapLibre and its GL
         surface; well over a thousand lines of views), long enough on the unit's SoC that, with nothing on screen
         after the tap, it looked dead and was tapped again. Near-black for a moment on the light theme is the
         lesser fault there. Settings, quicker to its first frame, stays without one. -->
    <style name="Theme.Aura.Heavy" parent="Theme.Aura">
        <item name="android:windowDisablePreview">false</item>
    </style>

    <!-- BootHome: the black the boot animation ends on, until the home screen can start; nothing moves. -->
    <style name="Theme.Aura.Boot" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
