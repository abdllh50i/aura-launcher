<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Aura" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text2</item>
        <item name="android:textColorHint">@color/text3</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@style/Aura.ScreenChange</item>
    </style>

    <!-- Opening and closing AMRI's screens (they play while the system's transition animations are on: see
         system/Animations.kt; this firmware ships with them off). -->
    <style name="Aura.ScreenChange" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/aura_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/aura_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/aura_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/aura_close_exit</item>
        <item name="android:taskOpenEnterAnimation">@anim/aura_open_enter</item>
        <item name="android:taskOpenExitAnimation">@anim/aura_open_exit</item>
        <item name="android:taskCloseEnterAnimation">@anim/aura_close_enter</item>
        <item name="android:taskCloseExitAnimation">@anim/aura_close_exit</item>
    </style>

    <style name="Theme.Aura.Home" parent="Theme.Aura">
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>
