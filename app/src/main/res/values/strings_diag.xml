<!-- The screen check (Settings › About): one button, about three minutes, a report to photograph and to send to the owner's server -->
<resources>
    <string name="diag_title">Screen check</string>
    <string name="diag_about_sub">Measures memory, drawing and the map on this unit, and gives you a report to photograph. Runs only when you press its button.</string>
    <string name="diag_intro">Measures what this unit can really do: memory, drawing, the map and motion over it. Takes about three minutes, and the screen changes meanwhile. Park the car first.</string>
    <string name="diag_start_send">Run the check and send the report to your server</string>
    <string name="diag_start_keep">Run the check (nothing sent: no server is set)</string>
    <string name="diag_privacy">Nothing runs and nothing is sent unless you press the button. The report has no server key, no Home or Work location, no contacts, no messages and no song names.</string>
    <string name="diag_no_server">The lyrics server is not set, so the report stays here on the unit and shows on this page. Set it in Display &amp; sound › Music.</string>
    <string name="diag_running_sub">Stay parked. Please do not turn the car off.</string>
