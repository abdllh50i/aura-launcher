<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the tool that renders the 3D car into the turntable frames shipped with the app (tools/car3d); the map alone on the screen (scripts/map-look.ps1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Every component of the design system at real size: am broadcast -n com.abdllh.aura/.debug.GalleryReceiver (GalleryPanel.kt) -->
        <receiver
            android:name=".debug.GalleryReceiver"
            android:exported="true" />
        <!-- The chrome's switch, its states and its frame times: am broadcast -n com.abdllh.aura/.debug.ChromeProbe (ChromeProbe.kt) -->
        <receiver
            android:name=".debug.ChromeProbe"
            android:exported="true" />
        <!-- Home's states with the mockups' words: am broadcast -n com.abdllh.aura/.debug.HomeProbe (HomeProbe.kt) -->
        <receiver
            android:name=".debug.HomeProbe"
            android:exported="true" />
        <activity
            android:name=".debug.CarBakerActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <activity
            android:name=".debug.MapLookActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <!-- The panel stack under quick changes of mind: am broadcast -a com.abdllh.aura.debug.PANELS (ProbePanel.kt) -->
        <receiver
            android:name=".debug.PanelStress"
            android:exported="true">
            <intent-filter>
                <action android:name="com.abdllh.aura.debug.PANELS" />
            </intent-filter>
        </receiver>
        <!-- The -PstandIn copy in the place of YouTube's app, for the hand-over and its way back (YtStandIn.kt) -->
        <activity
            android:name=".debug.YtStandIn"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="www.youtube.com" />
            </intent-filter>
        </activity>
    </application>
</manifest>
