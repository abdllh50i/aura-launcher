<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: the tool that renders the 3D car into the turntable frames shipped with the app (tools/car3d). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".debug.CarBakerActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <!-- The panel stack under quick changes of mind: am broadcast -a com.abdllh.aura.debug.PANELS (ProbePanel.kt) -->
        <receiver
            android:name=".debug.PanelStress"
            android:exported="true">
            <intent-filter>
                <action android:name="com.abdllh.aura.debug.PANELS" />
            </intent-filter>
        </receiver>
        <!-- The -PstandIn copy in the place of YouTube's app, for the hand-over and its way back (YtStandIn.kt) -->
        <activity
            android:name=".debug.YtStandIn"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="https" android:host="www.youtube.com" />
            </intent-filter>
        </activity>
    </application>
</manifest>
