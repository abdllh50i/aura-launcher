      "input": {"text": "https://maps.app.goo.gl/Q6ZugPBVWvuiVb8e8"},
      "redirects": {"https://maps.app.goo.gl/Q6ZugPBVWvuiVb8e8": {"code": 302, "location": "https://www.google.com/maps/place/42.578496,1.895566/data=!4m6!3m5!1s0!7e2!8m2!3d42.5784957!4d1.8955661?utm_source=mstt_1&entry=gps"}},
      "expect": {"kind": "place", "lat": 42.5784957, "lon": 1.8955661, "name": "", "detail": "", "src": "share.google", "confidence": "exact"}
