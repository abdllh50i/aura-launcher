{
  "version": 1,
  "about": "What a phone shares, and the one thing it means. For link/ShareParser.kt now (scripts/phone-server-test.py runs them through the unit's real parser) and the phone's Swift parser later: the same input must give the same answer. input.text is everything shared, the link included. redirects stands in for the network: the short link's answer, by URL, as {code, location} (location is what the Location header said, null for none), or \"error\" for no answer at all; a URL not listed must never be asked for. withinMs: the answer must come in that time, on the phone as on the unit (a shared text must never cost a thread for good). expect.kind is place (lat, lon within 0.000001 unless tolerance says otherwise, name, detail, src, confidence), search (q, src), unresolved (reason, q when text came with the link) or nothing (reason). Marked measured: seen live from the PC (companion.md 2.5). The rest are the formats the report lists, written by hand: replace them with real captures from the phone as they come.",
  "cases": [
    {
      "name": "Apple Maps short link: the first Location is read, the page behind it never",
      "measured": true,
      "input": {"text": "https://maps.apple/p/7E-Brjrk_THN14"},
      "redirects": {"https://maps.apple/p/7E-Brjrk_THN14": {"code": 301, "location": "https://maps.apple.com/place?address=Sonnenallee%20223,%2012059%20Berlin,%20Germany&coordinate=52.4737758%2C13.4373898&name=Marked%20Location"}},
      "expect": {"kind": "place", "lat": 52.4737758, "lon": 13.4373898, "name": "Marked Location", "detail": "Sonnenallee 223, 12059 Berlin, Germany", "src": "share.apple", "confidence": "exact"}
    },
    {
      "name": "Apple Maps: ll and q, with an Arabic name",
      "input": {"text": "https://maps.apple.com/?ll=26.290457,50.184555&q=%D8%A7%D9%84%D8%B1%D8%A7%D8%B4%D8%AF%20%D9%85%D9%88%D9%84"},
      "expect": {"kind": "place", "lat": 26.290457, "lon": 50.184555, "name": "الراشد مول", "detail": "", "src": "share.apple", "confidence": "exact"}
    },
    {
      "name": "Apple Maps: coordinate in the new form, the name in the shared text",
      "input": {"text": "الراشد مول\nhttps://maps.apple.com/place?coordinate=26.290457,50.184555"},
      "expect": {"kind": "place", "lat": 26.290457, "lon": 50.184555, "name": "الراشد مول", "detail": "", "src": "share.apple", "confidence": "exact"}
    },
    {
      "name": "Apple Maps: directions to coordinates",
      "input": {"text": "https://maps.apple.com/?daddr=26.290457,50.184555&dirflg=d"},
      "expect": {"kind": "place", "lat": 26.290457, "lon": 50.184555, "name": "", "detail": "", "src": "share.apple", "confidence": "exact"}
    },
    {
      "name": "Apple Maps: a Place ID with an address and no coordinate: a search, on the unit (the phone has Apple's lookup)",
      "measured": true,
      "input": {"text": "https://maps.apple.com/place?place-id=I3B04EDEB21D5F86&address=King%20Khalid%20St%2C%20Al%20Khobar&_provider=9902"},
      "expect": {"kind": "search", "q": "King Khalid St, Al Khobar", "src": "share.apple"}
    },
    {
      "name": "Apple Maps: a Place ID alone: says so, guesses nothing",
      "measured": true,
      "input": {"text": "https://maps.apple.com/place?place-id=I3B04EDEB21D5F86&_provider=9902"},
      "expect": {"kind": "unresolved", "reason": "no_place"}
    },
    {
