      "id": "apple-short-link-first-location",
      "note": "One request, no redirect, read the first Location. Following on can end at /unsupported.",
      "input": { "urls": ["https://maps.apple/p/7E-Brjrk_THN14"] },
      "redirects": {
        "https://maps.apple/p/7E-Brjrk_THN14": { "status": 301, "location": "https://maps.apple.com/place?address=Berlin&coordinate=52.4737758%2C13.4373898" }
      },
      "expect": { "kind": "place", "lat": 52.4737758, "lon": 13.4373898, "confidence": "exact", "src": "share.apple" }
    },
    {
      "id": "apple-short-link-named-by-text",
